# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

# Uploads are NOT ignored: the GitHub Actions build copies media/ into the
# published site, so these files have to be in the repo. Keep an eye on the
# size of anything you upload — video especially.

# Admin panel is parked here mid static build; never commit it
/.payload-admin-parked

# Claude Code machine-local settings and temp files
.claude/settings.local.json
.claude/*.tmp.*
.claude/settings.local.json.tmp.*

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# sqlite database
# portfolio.db is the working database and stays local — it holds the Payload
# users row (admin email, password hash, salt).
*.db
*.db-shm
*.db-wal
*.db.staging

# content.db is the scrubbed, publishable copy produced by
# `npm run publish:content`. It has no user rows and is what Actions builds
# the site from, so it is deliberately committed.
!content.db
