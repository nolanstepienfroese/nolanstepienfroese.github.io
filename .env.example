# Copy to .env for local development. Never commit .env.
#
# The working database. Holds your admin user (email + password hash), so it
# stays local — see .gitignore. `npm run publish:content` derives the scrubbed,
# committable content.db from it.
DATABASE_URL=file:./portfolio.db

# Signs admin sessions. Generate your own, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=YOUR_SECRET_HERE
